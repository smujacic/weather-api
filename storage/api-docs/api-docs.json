                ],
                "summary": "Create city",
                "operationId": "5e7b2ab311c92d3f20ed40b2e0de8e9c",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "lat",
                                    "long"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Zagreb"
                                    },
                                    "lat": {
                                        "type": "number",
                                        "example": 45.815
                                    },
                                    "long": {
                                        "type": "number",
                                        "example": 15.9819
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "City created"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
